# ---------------------------------------------------------------------------
# CyberLab configuration. Copy to .env and fill in real values.
# Never commit .env.
# ---------------------------------------------------------------------------

# "development" allows HTTP and an ephemeral secret. "production" refuses to
# start without a strong secret and a non-default admin password.
CYBERLAB_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CYBERLAB_SECRET_KEY=replace-me-with-48-random-bytes

# First-run admin account. The password is hashed on first start; later changes
# are made with: python -m app.cli set-password
CYBERLAB_ADMIN_USERNAME=admin
CYBERLAB_ADMIN_PASSWORD=replace-me-with-a-long-unique-password

# Where SQLite and the audit trail live.
CYBERLAB_DATA_DIR=./data

# Bind address for the dashboard and for challenge host ports.
# Use 127.0.0.1 for SSH tunnels, or your VPN interface IP (e.g. 10.8.0.1).
CYBERLAB_BIND_IP=127.0.0.1

# Hostname the browser uses for the dashboard. This MUST be different from
# CYBERLAB_CHALLENGE_HOST: cookies are not scoped by port, so a shared hostname
# would send the admin session cookie to hostile challenge containers.
# For local use, "localhost" is fine. For VPN use, a private DNS name such as
# "lab.internal" is best.
CYBERLAB_PUBLIC_HOST=localhost

# Hostname the browser uses for challenge instances. It must resolve to the
# same machine as CYBERLAB_BIND_IP. "127.0.0.1" works locally; for VPN use,
# something like "challenges.lab.internal".
CYBERLAB_CHALLENGE_HOST=127.0.0.1

# Dashboard port (when running uvicorn directly).
CYBERLAB_CONTROL_PORT=8443

# Set true when Caddy/TLS terminates the dashboard.
CYBERLAB_SESSION_HTTPS_ONLY=false

# Comma-separated allowed Host headers for the dashboard. Keep this to the
# canonical dashboard hostname(s). /healthz is exempt for container checks.
CYBERLAB_ALLOWED_HOSTS=localhost

# Default lifetime for a challenge instance.
CYBERLAB_INSTANCE_TTL_MINUTES=30

# Fixed host-port range for challenge instances. Firewall only this range to
# your VPN/LAN instead of opening the whole ephemeral range.
CYBERLAB_INSTANCE_PORT_MIN=20000
CYBERLAB_INSTANCE_PORT_MAX=20099

# Runtime caps applied to every challenge container.
CYBERLAB_LAB_MEMORY_LIMIT=256m
CYBERLAB_LAB_CPU_LIMIT=0.5
CYBERLAB_LAB_PIDS_LIMIT=64

# Internal Docker network for challenge containers (no internet egress).
CYBERLAB_DOCKER_NETWORK=cyberlab_labs

# Normal Docker network used only by the per-instance relay that publishes the
# challenge port. Challenge containers never join this network.
CYBERLAB_DOCKER_EDGE_NETWORK=cyberlab_edge

# Trusted relay image built by scripts/build-challenges.sh.
CYBERLAB_FORWARDER_IMAGE=cyberlab/forwarder:latest

# Optional: point at a socket proxy, e.g. tcp://socket-proxy:2375.
# Leave empty to use the local Docker socket.
CYBERLAB_DOCKER_HOST=

CYBERLAB_LOG_LEVEL=INFO
